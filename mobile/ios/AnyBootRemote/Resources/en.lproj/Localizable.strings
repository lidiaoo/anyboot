"remote.priorityHelp" = "Drag ☰ (or click ↑↓) to reorder; probes and API requests try channels in this order, using the first that works. Each channel can set its own timeout: 1–2 s is enough on a LAN, while public Funnel/built-in Funnel may need 5–8 s for the first handshake. A blank cell uses the default below.";
"remote.priorityProbeLabel" = "How to probe the priority channels (how the six channels are tried; applies to every channel above)";
"remote.priorityProbeAria" = "Priority probe method";
"remote.probeHelp" = "Probing on the computer page and list follows this: Parallel (first) fires all channels at once and uses the first success; Parallel (all) waits for all and reports each channel's result and time; Serial tries channels in the priority order and stops at the first success. This is channel-level; the “multi-NIC probe” below is address-level within one channel. Probes run on a separate thread pool, so larger timeouts or Parallel (all) won't freeze the UI.";
"remote.blockStrategyLabel" = "Per-block strategy (how multiple entries in one block are probed) + block default timeout";
"remote.blockTimeoutTitle" = "This block's default probe timeout (s); blank = global default";
"remote.blockStrategyHelp" = "Per block: Parallel (first) stops at the first hit and marks the rest “not probed” (fast); Parallel (all) reports each entry (for health checks); Serial tries in row order and stops at the first success (strict priority). Under Parallel (first), order only affects launch order — earlier rows don't always win; choose Serial for strict order. Block default timeout applies to rows without their own; if blank, the global default below is used.";
"remote.multiNicLabel" = "Multi-NIC probe (how multiple addresses within one channel are probed)";
"remote.multiNicAria" = "Multi-NIC probe";
"remote.multiNicHelp" = "Applies when a computer has multiple LAN addresses (multiple NICs / changed IPs): Parallel (first) uses whichever works first; Parallel (all) waits for all; Serial tries in address order and stops at the first success.";
"remote.defaultTimeoutLabel" = "Default probe timeout (s) — used when a channel cell is blank";
"remote.defaultTimeoutHelp" = "Default 2 s (range 0.2–30 s). To wait longer/shorter for a channel, fill that row's cell — a filled cell wins; blank cells use this default.";
"remote.viaJumpLabel" = "Via jump host (per address)";
"remote.viaJumpHelp" = "Jump hosts are per address — each “LAN address” row above has its own jump-host dropdown; empty = direct. With three NICs you can relay each via home/office jump hosts independently.";
