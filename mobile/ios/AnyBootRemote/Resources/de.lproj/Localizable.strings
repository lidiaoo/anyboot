"gw.hintLinkValidSys" = "⏱️ Der Login-Link ist ca. <b>10 Minuten</b> gültig; bei Ablauf/ohne Reaktion <b>Link neu erzeugen</b> oder den Schalter <b>aus- und einschalten</b>.";
"gw.hintLinkCopySys" = "Der Link kann auch im Browser von Handy/anderen Geräten geöffnet werden; nach Autorisierung zurück und den Schalter einmal umschalten.";
"gw.hintTsnetOnly" = "⚠️ Diese Adresse ist nur für Geräte im selben Tailnet (gleiches Tailscale-Konto) erreichbar; Sicherheit hängt am Kopplungstoken – Code nicht weitergeben. Das Ziel ist im Ruhezustand offline – Aufwecken braucht einen dauerhaft laufenden LAN-Sprungserver.";
"gw.hintTsStopped" = "Tailscale ist gestoppt – im Systemtray / der Menüleiste verbinden, dann „Erneut erkennen“.";
"gw.hintTsGuiDown" = "Tailscale ist installiert, aber die GUI läuft nicht – unten klicken, um Tailscale.app zu öffnen (bereit, wenn das Menüleisten-Symbol erscheint); nach ein paar Sekunden automatisch erneut erkannt.";
"gw.openTsApp" = "Tailscale.app öffnen";
"gw.hintTsOldExt" = "Tailscale ist installiert, aber die alte Netzwerkerweiterung ist noch „Deinstallation beim Neustart ausstehend“ – die neue kann nicht aktivieren, Verbindungen schlagen weiter fehl. Nach einem Mac-Neustart wird automatisch gewechselt; dann „Erneut erkennen“. (Neuinstallation hilft nicht – nicht wiederholt deinstallieren.)";
"gw.rebootRecheck" = "Neu gestartet, erneut erkennen";
"gw.hintTsExtNotAllowed" = "Tailscale ist installiert, aber die Netzwerkerweiterung noch nicht erlaubt – bis zur Freigabe kein Netz, Verbinden scheitert. Unten klicken: „Systemeinstellungen → Allgemein → Anmeldeobjekte & Erweiterungen → Netzwerkerweiterungen“, Tailscale aktivieren (evtl. Fingerabdruck/Passwort); dann „Erneut erkennen“.";
"gw.openExtSettings" = "Netzwerkerweiterungs-Einstellungen öffnen";
"gw.hintFunnelPublish" = "Den Dienst dieses Rechners über das offizielle Tailscale-Relay als öffentliche Adresse veröffentlichen (https://rechnername.ts.net) – Handys erreichen ihn ohne Tailscale, Adresse fest. In manchen Regionen ggf. instabil, Bandbreite begrenzt.";
"gw.hintFunnelAuth" = "Auf der offiziellen Tailscale-Seite Funnel erlauben und ein HTTPS-Zertifikat aktivieren (Owner/Admin-Konto nötig); eine Autorisierung gilt lange.";
"gw.hintTsLogout" = "Führt tailscale logout aus: trennt und löscht lokale Anmeldedaten und gespeicherten AuthKey; nächstes Mal erneute Autorisierung. Geräteeinträge in der Tailscale-Konsole manuell entfernen.";
"gw.hintTsnPublish" = "Kein Tailscale nötig – die integrierte Engine veröffentlicht den Dienst als öffentliche Adresse (https://anyboot.….ts.net); Handys erreichen ihn ohne Tailscale, Adresse fest. Erste Verbindung zum Koordinationsserver ggf. instabil, Relay-Traffic bandbreitenbegrenzt.";
"gw.hintTsnAuthKey" = "Einmaligen Geräte-Auth-Key in der Tailscale-Konsole → Settings → Keys ausstellen; damit kein Browser-Login beim Start der Engine.";
"gw.hintTsnLogin" = "Tailscale-Konto-Login nötig – unten auf die Schaltfläche zum Autorisieren im Browser (einmal genügt, Daten gemerkt). Danach läuft die Engine automatisch weiter, kein Umschalten nötig. Die Engine initialisiert Umgebungsressourcen (Knoten-Konfig, HTTPS-Zertifikat, öffentliches DNS usw.), meist einige Minuten – alle paar Minuten Status/Log prüfen; bereit erscheint es hier und die öffentliche Adresse im Log.";
