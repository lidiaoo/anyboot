<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 局域网里要能看到电脑上的 AnyBoot，最好别让它以为必须走 WiFi（有线/热点/以太网都要能用） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 远程接入扫码配对（ScanPairActivity 运行时再申请，不扫也能粘贴） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 检查更新：下载 APK 后交给系统安装器（Android 8+ 还需要用户在系统设置里
         单独允许「安装未知应用」，客户端会引导跳转，不静默索要） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 电脑列表（电源 + rEFInd/GRUB 引导项，design/mobile-computer-list.html） -->
        <activity
            android:name=".ComputerListActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <!-- 服务器模块（跳板机管理 + 底部导航：服务器/会话/密钥/传输/文件） -->
        <activity
            android:name=".ServersActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <!-- 终端设置（服务器模块标题栏齿轮图标 → 独立界面） -->
        <activity
            android:name=".TerminalSettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <!-- xterm 终端会话页 -->
        <activity
            android:name=".TerminalActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- 关于页（GitHub 仓库卡片 + Star 引导） -->
        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <!-- 检查更新（下载 APK → SHA-256 校验 → 交给系统安装器覆盖升级） -->
        <activity
            android:name=".UpdateActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <!-- 更新包共享给系统安装器：Android 7+ 禁止 file:// 跨应用，必须走 FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 备份与恢复（导出/导入 + WebDAV 多端同步） -->
        <activity
            android:name=".BackupActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />

        <!-- 扫码读配对码（远程接入；锁竖屏省掉一整套旋转处理） -->
        <activity
            android:name=".ScanPairActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false" />
    </application>
</manifest>
