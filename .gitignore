node_modules/
dist/
src-tauri/target*/
src-tauri/gen/
# 构建临时目录（TMP/TEMP 指到这里：WiX/NSIS 打包要在临时目录落几 GB，
# C 盘紧的时候会把 os error 112 甩出来）。放项目内，别再用外部盘。
.build/
*.local
.DS_Store
.idea/
.vscode/
*.iml

# --- Android / Gradle 构建产物（源码与 README 入库，产物不入库） ---
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
mobile/android/app/release/
mobile/android/captures/
*.apk
*.aab
*.keystore

# --- iOS / Xcode 构建产物（源码与 README 入库，产物不入库） ---
# .xcodeproj 由 project.yml 经 xcodegen 生成（见 mobile/ios/project.yml），不入库
mobile/ios/*.xcodeproj/
mobile/ios/build/
mobile/ios/DerivedData/
mobile/ios/*.xcodeproj/xcuserdata/
mobile/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
mobile/ios/*.xcworkspace/xcuserdata/
mobile/ios/.build/
xcuserdata/

# JVM 崩溃日志与签名产物
hs_err_pid*.log
*.idsig

# JVM 崩溃日志与签名产物
hs_err_pid*.log
*.idsig

# WorkBuddy 工作区临时脚本（一次性工具，可复用版在 ~/.workbuddy/skills/）
.workbuddy/tmp/

# --- WorkBuddy 工作区数据 ---
# memory/（MEMORY.md + 每日日志）和 probes/（量窗口坐标的小工具）**照常入库**：
#   memory 记的是「为什么这么改」和踩过的坑，比代码注释值钱。
# artifacts/ 是每次修完 UI 的验证截图，属于一次性现场证据：没有文档引用，
#   二进制只增不减，事后也分不清是哪次改动的。忽略，只留本地。
#   要把证据跟改动绑一起，就写进 commit message，别塞进仓库。
.workbuddy/artifacts/

# dsh ���ؼ�⹤���� WorkBuddy ͼ�깤��Ŀ¼�����ز������⣩
.dsh/
.workbuddy/icon/

# CI 产物下载目录（gh run download 的安装包，220M，release 已有同名附件）
dist-ci/

# UI 集成预览副本（docs/ui-preview 是 ui/ 源码的临时快照，改完即弃）
docs/ui-preview/
